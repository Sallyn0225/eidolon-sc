{
  "name": "eidolon-frontend",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "theme:build": "astryx theme build src/theme/notebookTheme.ts -o src/theme/built/notebookTheme.css --icons-specifier ../astryxIcons",
    "theme:check": "astryx theme build --check src/theme/notebookTheme.ts -o src/theme/built/notebookTheme.css --icons-specifier ../astryxIcons",
    "stand:thumbnails": "node --env-file-if-exists=../.env scripts/stand-thumbnails.mts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.3",
    "@pipecat-ai/client-js": "^1.13.1",
    "@pipecat-ai/small-webrtc-transport": "^1.10.8",
    "@stylexjs/stylex": "0.19.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.63.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
